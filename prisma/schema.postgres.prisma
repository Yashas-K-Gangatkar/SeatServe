// NotiFetch — normalized schema (campus-first).
// NOTE: SQLite does not support Prisma enums — status/type fields are String
// columns constrained by zod + TypeScript union types in src/lib/types.ts.
// PHASE 4: this file targets SQLite (sandbox). `scripts/make-postgres-schema.mjs`
// generates prisma/schema.postgres.prisma — the IDENTICAL schema with the
// PostgreSQL provider — so production and sandbox never drift apart.
// SQLite here, Postgres in production: zero schema changes required.
//
// CAMPUS PIVOT (Sep 2026): venue language is university-first — Campus →
// Block → Classroom → Seat, Lectures instead of showtimes. Physical table
// and column names are KEPT (the cinema-era names) via @@map/@map, so the
// live production database (real Razorpay orders, staff logins, the mall
// demo) carried over with ZERO data movement and zero downtime.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Venues ─────────────────────────────

// A campus (was "mall") — the top-level tenant: a college/university
// campus (or, for the legacy mall demo, a shopping mall).
model Campus {
  id        String         @id @default(cuid())
  name      String
  city      String
  address   String
  createdAt DateTime       @default(now())
  blocks   Block[]
  stores    Store[]
  zones     DeliveryZone[]
  orders    Order[]
  users     User[]
  auditLogs AuditLog[]

  @@map("Mall")
}

// An academic block (was "cinema") — one building of the campus.
model Block {
  id        String   @id @default(cuid())
  campusId    String   @map("mallId")
  campus      Campus     @relation(fields: [campusId], references: [id])
  name      String
  wing      String?
  createdAt DateTime @default(now())
  classrooms   Classroom[]
  users     User[]

  @@map("Cinema")
}

// A classroom (was "screen") — rows × cols of seats. Two ways to order:
// scan a per-seat QR (cinema style) or the DOOR QR sticker pasted outside
// the classroom (campus style — one sticker per room, student types their
// seat/roll number at checkout).
model Classroom {
  id        String     @id @default(cuid())
  blockId  String     @map("cinemaId")
  block    Block     @relation(fields: [blockId], references: [id])
  name      String // "Room A-101"
  seatRows  Int
  seatCols  Int
  doorQrToken String?  @unique // campus flow: QR sticker at the classroom door — /?qr=<token>
  seats     Seat[]
  lectures Lecture[]
  orders    Order[]
  createdAt DateTime   @default(now())

  @@map("Screen")
}

model Seat {
  id         String   @id @default(cuid())
  classroomId   String   @map("screenId")
  classroom     Classroom   @relation(fields: [classroomId], references: [id])
  code       String // "F-12"
  rowLabel   String
  seatNumber Int
  qrToken    String   @unique // what the printed QR encodes: /?qr=<token>
  createdAt  DateTime @default(now())
  orders     Order[]
}

// A lecture/period on a classroom's timetable (was "showtime"). Its start
// time doubles as the natural delivery slot: order during class, food lands
// when the bell rings.
model Lecture {
  id                 String   @id @default(cuid())
  classroomId           String   @map("screenId")
  classroom             Classroom   @relation(fields: [classroomId], references: [id])
  subject         String   @map("movieTitle") // e.g. "Physics"
  language           String?
  startsAt           DateTime
  orderCutoffMinutes Int      @default(30) // ordering closes N minutes before start
  isActive           Boolean  @default(true)
  // Sandbox-demo guardian: when true, a stale (already-started) lecture is
  // rolled forward so the demo never dead-ends at the ordering cutoff.
  // The one intentionally-blocked demo lecture sets this to false.
  demoAutoRoll       Boolean  @default(true)
  createdAt          DateTime @default(now())
  orders             Order[]

  @@map("Showtime")
}

model DeliveryZone {
  id          String   @id @default(cuid())
  campusId      String   @map("mallId")
  campus        Campus     @relation(fields: [campusId], references: [id])
  name        String // "Wing A · Screens 1–3"
  description String?
  runners     Runner[]
}

// ───────────────────────────── Catalog ─────────────────────────────

model Store {
  id               String        @id @default(cuid())
  campusId           String       @map("mallId")
  campus             Campus          @relation(fields: [campusId], references: [id])
  name             String
  slug             String        @unique
  tagline          String?
  emoji            String? // demo visual identity
  isOpen           Boolean       @default(true)
  prepBufferMin    Int           @default(10) // extra handling for block delivery
  // NO delivery fee — stores sit next door to the classrooms (owner decision)
  commissionPct    Float         @default(12) // platform commission
  kycStatus        String        @default("PENDING") // PENDING | VERIFIED | REJECTED
  kycDetail        String? // JSON snapshot: { gstin, panMasked, bankMasked, fssai, submittedAt } — masked only, never full credentials
  bankRefMasked    String? // e.g. "XXXX4821" — never real credentials
  rating           Float         @default(4.5)
  createdAt        DateTime      @default(now())
  products         Product[]
  tickets          StoreTicket[]
  users            User[]
  splits           Split[]
  settlements      Settlement[]
}

model Product {
  id              String      @id @default(cuid())
  storeId         String
  store           Store       @relation(fields: [storeId], references: [id])
  name            String
  description     String?
  category        String      @default("Snacks")
  pricePaise      Int // inclusive of GST (India menu convention)
  taxRatePct      Float       @default(5) // GST %
  prepEstimateMin Int         @default(8)
  isVeg           Boolean     @default(true)
  allergens       String? // "nuts, dairy"
  imageUrl        String? // food photo (/menu/xxx.jpg or full URL) — compulsory via manager UI
  isAvailable     Boolean     @default(true)
  createdAt       DateTime    @default(now())
  cartItems       CartItem[]
  orderItems      OrderItem[]
}

// ───────────────────────────── Commerce ─────────────────────────────

model Cart {
  id        String     @id @default(cuid())
  seatId    String?
  status    String     @default("ACTIVE") // ACTIVE | CONVERTED | ABANDONED
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     CartItem[]
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  qty       Int
  notes     String?
}

model Order {
  id               String        @id @default(cuid())
  code             String        @unique // "SS-7K2QX9"
  campusId           String       @map("mallId")
  campus             Campus          @relation(fields: [campusId], references: [id])
  blockId         String       @map("cinemaId")
  classroomId         String       @map("screenId")
  classroom           Classroom        @relation(fields: [classroomId], references: [id])
  // seatId is OPTIONAL since the campus pivot: door-QR orders target the
  // classroom (delivery at the door) and carry seatLabel ("A-12" / roll no)
  // instead of a Seat row. Legacy seat-QR orders still set seatId.
  seatId           String?
  seat             Seat?         @relation(fields: [seatId], references: [id])
  seatLabel        String? // "A-12" or roll number typed at checkout (door-QR flow)
  lectureId       String?      @map("showtimeId")
  lecture         Lecture?     @relation(fields: [lectureId], references: [id])
  status           String        @default("PENDING_PAYMENT") // PENDING_PAYMENT | PAID | COMPLETED | CANCELLED | PARTIALLY_CANCELLED
  paymentStatus    String        @default("PENDING") // PENDING | PAID | FAILED — no refund statuses: block policy is counter-side resolution
  subtotalPaise    Int // sum of line totals (GST-inclusive; stores remit their own GST)
  platformFeePaise Int // 5% of the total the customer pays
  totalPaise       Int
  customerName     String?
  customerPhone    String?
  placedAt         DateTime      @default(now())
  scheduledFor     DateTime? // customer-requested FUTURE delivery slot (class break at 11:00, movie interval); null = deliver ASAP
  completedAt      DateTime?
  items            OrderItem[]
  tickets          StoreTicket[]
  payments         Payment[]
  splits           Split[]
  events           AuditLog[]
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id])
  productId      String?
  product        Product? @relation(fields: [productId], references: [id])
  storeId        String
  nameSnapshot   String
  unitPricePaise Int // GST-inclusive snapshot
  qty            Int
  taxRatePct     Float
  lineTotalPaise Int
  notes          String? // allergy / prep notes
}

model StoreTicket {
  id             String       @id @default(cuid())
  orderId        String
  order          Order        @relation(fields: [orderId], references: [id])
  storeId        String
  store          Store        @relation(fields: [storeId], references: [id])
  ticketCode     String       @unique
  status         String       @default("NEW") // NEW | ACCEPTED | PREPARING | READY_FOR_PICKUP | PICKED_UP | DELIVERED | CANCELLED
  subtotalPaise  Int
  prepEtaMinutes Int
  acceptedAt     DateTime?
  preparingAt    DateTime?
  readyAt        DateTime?
  pickedUpAt     DateTime?
  deliveredAt    DateTime?
  cancelledAt    DateTime?
  // who cancelled this leg: CUSTOMER (self-service partial cancel) |
  // KITCHEN_STAFF / STORE_MANAGER / CAMPUS_ADMIN (staff cancel). Drives the
  // customer-facing tracking message ("you cancelled" vs "store cancelled").
  cancelledByRole String?
  customerNote   String?
  createdAt      DateTime     @default(now())
  deliveryRun    DeliveryRun?
}

model Runner {
  id       String        @id @default(cuid())
  name     String
  phone    String
  zoneId   String?
  zone     DeliveryZone? @relation(fields: [zoneId], references: [id])
  isOnDuty Boolean       @default(true)
  rating   Float         @default(4.8)
  runs     DeliveryRun[]
  user     User?
}

model DeliveryRun {
  id          String      @id @default(cuid())
  ticketId    String      @unique
  ticket      StoreTicket @relation(fields: [ticketId], references: [id])
  runnerId    String
  runner      Runner      @relation(fields: [runnerId], references: [id])
  status      String      @default("ASSIGNED") // ASSIGNED | PICKED_UP | DELIVERED
  pickupLabel String
  dropLabel   String
  assignedAt  DateTime    @default(now())
  pickedUpAt  DateTime?
  deliveredAt DateTime?
}

// ───────────────────────────── Payments ─────────────────────────────

model Payment {
  id             String         @id @default(cuid())
  orderId        String
  order          Order          @relation(fields: [orderId], references: [id])
  provider       String         @default("SANDBOX_MOCK") // Phase 3: RAZORPAY | CASHFREE
  method         String // UPI | CARD | NETBANKING
  amountPaise    Int
  status         String         @default("INITIATED") // INITIATED | SUCCESS | FAILED
  providerRef    String         @unique // fake gateway ref (e.g. pay_mock_xxx)
  idempotencyKey String         @unique
  methodDetail   String? // masked: VPA "name@bank", card "•••• 4242" — demo only, never secrets
  failureReason  String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  events         PaymentEvent[]
}

model PaymentEvent {
  id             String    @id @default(cuid())
  provider       String
  eventType      String // payment.captured | payment.failed | refund.processed
  dedupeKey      String    @unique // provider event id — duplicate-webhook protection
  signatureValid Boolean
  payload        String // raw JSON snapshot
  paymentId      String?
  payment        Payment?  @relation(fields: [paymentId], references: [id])
  receivedAt     DateTime  @default(now())
  processedAt    DateTime?
}

model Split {
  id               String   @id @default(cuid())
  orderId          String
  order            Order    @relation(fields: [orderId], references: [id])
  storeId          String?
  store            Store?   @relation(fields: [storeId], references: [id])
  beneficiary      String // STORE | PLATFORM_COMMISSION | DELIVERY_FEE | TAX | PAYMENT_FEE
  amountPaise      Int
  // Phase 3: per-store tax & commission carried ON the STORE row so settlement
  // is ledger-driven (no re-derivation): storeNet = amount = subtotal − tax − commission.
  // TAX rows carry taxPaise = amount; adjustment (negative) rows carry negatives.
  commissionPaise  Int      @default(0)
  taxPaise         Int      @default(0)
  // PENDING | SETTLED — normal ledger. VOIDED — leg cancelled before
  // fulfilment, never owed (settlement-internal; there are no online refunds:
  // the block's policy is counter-side resolution only).
  settlementStatus String   @default("PENDING")
  settlementId     String?
  createdAt        DateTime @default(now())
}

model Settlement {
  id           String   @id @default(cuid())
  storeId      String
  store        Store    @relation(fields: [storeId], references: [id])
  amountPaise  Int // net payable = Σ PENDING STORE rows at batch creation
  periodStart  DateTime
  periodEnd    DateTime
  status       String   @default("PENDING") // PENDING | PROCESSED | FAILED
  utr          String? // fake bank reference in Phase 3
  // JSON snapshot: { grossPaise, commissionPaise, taxPaise, voidAdjustPaise, splitIds[] }
  detail       String?
  processedAt  DateTime?
  createdAt    DateTime @default(now())
}

// ───────────────────────────── Governance ─────────────────────────────

model User {
  id           String   @id @default(cuid())
  name         String
  phone        String   @unique
  email        String?  @unique
  role         String // CUSTOMER | CAMPUS_ADMIN | BLOCK_MANAGER | STORE_MANAGER | KITCHEN_STAFF | RUNNER
  // Tenant scope — which slice of the platform this staff user may ever see.
  // Every staff API filter is derived from these fields (never from client input).
  campusId     String?  @map("mallId")
  blockId      String?  @map("cinemaId")
  storeId      String?
  campus       Campus?  @relation(fields: [campusId], references: [id])
  block        Block?   @relation(fields: [blockId], references: [id])
  store        Store?   @relation(fields: [storeId], references: [id])
  runnerId     String?  @unique
  runner       Runner?  @relation(fields: [runnerId], references: [id])
  passwordHash String? // scrypt — set in Phase 2 (staff portal login)
  isActive     Boolean  @default(true)
  sessions     Session[]
}

// Server-side sessions: the cookie carries an opaque random token; only its
// SHA-256 hash is stored, so a DB leak cannot be replayed as a login.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique // hex(sha256(token))
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  userAgent String?
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  actorRole  String // CUSTOMER | KITCHEN_STAFF | RUNNER | ADMIN | SYSTEM | GATEWAY
  actorRef   String?
  action     String // ORDER_PLACED | PAYMENT_CAPTURED | TICKET_STATUS_CHANGED | ...
  entityType String
  entityId   String
  meta       String? // JSON
  // Denormalized tenant scope — lets /api/audit filter EXACTLY by campus even for
  // events that carry no orderId (store/product/auth events).
  campusId     String?  @map("mallId")
  campus       Campus?  @relation(fields: [campusId], references: [id])
  orderId    String?
  order      Order?   @relation(fields: [orderId], references: [id])
  createdAt  DateTime @default(now())
}

model AppSetting {
  key       String   @id
  value     String // JSON
  updatedAt DateTime @updatedAt
}

// Hit-audit: the edge middleware aggregates every incoming request into
// (UTC day × UA class × path bucket) rows, so the owner can answer "WHO is
// hammering notifetch.in?" from our own API instead of paying for Vercel log
// access. Diagnostics only — rows can be truncated any time.
model HitAudit {
  id        String   @id @default(cuid())
  day       String // 'YYYY-MM-DD' (UTC)
  uaClass   String // browser | bot:bytespider | bot:curl-wget | junk-path | ...
  path      String // bucketed path (/api/orders/:code, /, /staff, ...)
  hits      Int      @default(0)
  ips       Int      @default(0) // approx distinct client-IP hashes (first-isolate estimate)
  updatedAt DateTime @updatedAt
  @@unique([day, uaClass, path])
  @@index([day, hits])
}
