{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "node scripts/make-postgres-schema.mjs && bunx prisma generate --schema prisma/schema.postgres.prisma && next build",
  "installCommand": "bun install",
  "crons": [
    {
      "path": "/api/health?cron=1",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/admin/settlement/auto-daily",
      "schedule": "20 17 * * *"
    }
  ]
}
