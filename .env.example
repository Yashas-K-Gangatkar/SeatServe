# SeatServe — environment template (values are NEVER committed)

# SQLite (local demo) / PostgreSQL (production)
DATABASE_URL="file:./db/custom.db"
# DATABASE_URL="postgresql://user:pass@host:5432/seatserve"

# Payment provider: SANDBOX_MOCK (no real money) | razorpay | cashfree
PAYMENT_PROVIDER=SANDBOX_MOCK

# Razorpay — key id decides mode by prefix (rzp_test_ / rzp_live_)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook signing secret from the Razorpay dashboard
RAZORPAY_WEBHOOK_SECRET=

# Cashfree (optional second provider)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_API_VERSION=
CASHFREE_ENV=sandbox
CASHFREE_WEBHOOK_SECRET=

# Realtime service (socket.io)
REALTIME_PORT=3003

# Staff roster sheet-sync (optional) — the roster sheet's share link.
# Accepts: Microsoft 365 / OneDrive "Anyone with the link (view)" URL
# (1drv.ms or *.sharepoint.com), a published Google-Sheet CSV link, or any
# direct .xlsx/.csv URL. When set, GET /api/cron/sheet-sync (cron-auth'd)
# applies the roster to staff accounts: create / update / deactivate.
# See docs/SHEET-SYNC.md.
SHEET_SYNC_URL=
